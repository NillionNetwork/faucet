NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Sepolia
NEXT_PUBLIC_FAUCET_ADDRESS_SEPOLIA=

# Sepolia — Blacklight L1 NIL, reached via `?chain=blacklight` and offered on the landing page.
NEXT_PUBLIC_FAUCET_ADDRESS_SEPOLIA_BLACKLIGHT=

# Anvil (local dev) - run `./docker/deploy-faucet.sh` to get the address
# NIL token is pre-deployed at 0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_FAUCET_ADDRESS_ANVIL=

# Optional: Your wallet address to fund with ETH on Anvil for gas
# Used by deploy-faucet.sh: DEV_WALLET=0x... pnpm docker:deploy
DEV_WALLET=

# L2 — Nillion Testnet (server-side faucet)
L2_FAUCET_PRIVATE_KEY=
L2_NIL_TOKEN_ADDRESS=0x69AD6D3E17C99A3f66b5Ae410a5D1D4E14C7da35
REDIS_URL=redis://localhost:6379
L2_FAUCET_COOLDOWN_MS=86400000
L2_FAUCET_ETH_AMOUNT=0.0001
L2_FAUCET_NIL_AMOUNT=70

# Blacklight L1 — Sepolia (server-side relayer, powers the "send to an address" field)
#
# Only the private key is a secret; everything else here is public config.
#
# The wallet needs NIL to hand out AND a little Sepolia ETH to pay gas on its own transfers.
# It never sends ETH onward, deliberately: this endpoint has no wallet requirement and so no
# real sybil cost, meaning it must only dispense something we do not mind losing. Sepolia ETH
# is scarce; testnet NIL is not.
#
# Sizing: the protocol fee is 0.0256 NIL per post, so a 20 NIL drip funds ~780 triggers. The
# wallet's balance is the blast radius if the key leaks — seed a few thousand NIL and top up,
# rather than parking the treasury here.
BLACKLIGHT_FAUCET_PRIVATE_KEY=
BLACKLIGHT_NIL_TOKEN_ADDRESS=0xA7526a2ABB3D01BD21B3ac59B9201cC018560Dfd
BLACKLIGHT_FAUCET_NIL_AMOUNT=20
BLACKLIGHT_FAUCET_COOLDOWN_MS=86400000
# Optional. Defaults to the keyless public Sepolia endpoint, which is ample for one read and
# one send. Putting a keyed URL here makes THIS a secret too.
# BLACKLIGHT_FAUCET_RPC_URL=
